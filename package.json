{
  "name": "motionai",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @motionai/app exec vue-tsc --noEmit -p tsconfig.json",
    "visor": "pnpm --filter @motionai/visor dev",
    "motionai": "tsx packages/render/src/cli.ts",
    "paridad": "tsx herramientas/paridad.ts",
    "fase2": "tsx herramientas/prueba-fase2.ts",
    "mcp": "node --disable-warning=ExperimentalWarning --import tsx packages/mcp/src/servidor.ts",
    "app": "pnpm --filter @motionai/app dev",
    "fase3": "tsx herramientas/prueba-fase3.ts",
    "fase4": "tsx herramientas/prueba-fase4.ts"
  },
  "devDependencies": {
    "@motionai/documento": "workspace:*",
    "@motionai/estudio": "workspace:*",
    "@motionai/mcp": "workspace:*",
    "@motionai/motor": "workspace:*",
    "@motionai/render": "workspace:*",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.0",
    "playwright-core": "^1.56.0",
    "skia-canvas": "^3.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
